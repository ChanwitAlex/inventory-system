# (ไม่บังคับ) ใช้เรียก API ภายนอก เช่น Postman ผ่าน header  x-api-key: <ค่านี้>
API_KEY="e9740949f5fa78ef81389967ee3240d938c7525f1a6161016f25061257d9cfe1"

# (ไม่บังคับ) เปิดปุ่ม Login ด้วย GitHub เมื่อใส่ทั้งสองค่า
AUTH_GITHUB_ID="Ov23lihJg49lE2stx0lP"
AUTH_GITHUB_SECRET="5be92016e14bfde22f72a1972f0ddfbdb0f3380a"

# (ไม่บังคับ) บัญชีแอดมินตอน seed
