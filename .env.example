# ฐานข้อมูล SQLite (ไฟล์จะอยู่ที่ ./dev.db)
DATABASE_URL="file:./dev.db"

# คีย์ลับสำหรับเซ็น session สร้างด้วย: npx auth secret  หรือ  openssl rand -base64 32
